  m_text: "\u041F\u0430\u0441\u0441\u0430\u0436 \u0431\u044B\u043B \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D
    \u0432 1916 \u0433\u043E\u0434\u0443. \u0410\u0432\u0442\u043E\u0440\u043E\u043C
    \u043F\u0440\u043E\u0435\u043A\u0442\u0430 \u0432\u044B\u0441\u0442\u0443\u043F\u0438\u043B
    \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D \u0411\u0430\u0431\u044B\u043A\u0438\u043D,
    \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440, \u0432\u043E \u043C\u043D\u043E\u0433\u043E\u043C
    \u0441\u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u0432\u0448\u0438\u0439
    \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u043D\u044B\u0439
    \u043E\u0431\u043B\u0438\u043A \u0415\u043A\u0430\u0442\u0435\u0440\u0438\u043D\u0431\u0443\u0440\u0433\u0430"
