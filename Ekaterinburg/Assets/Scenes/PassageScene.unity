    - target: {fileID: 6289246246839874908, guid: aa7410302b2fb064792550c342148338, type: 3}
      propertyPath: m_text
      value: "\u0412 \u043C\u0430\u0440\u0442\u0435 2012 \u043D\u0430\u0447\u0430\u043B\u0441\u044F
        \u0434\u0435\u043C\u043E\u043D\u0442\u0430\u0436 \u0437\u0434\u0430\u043D\u0438\u044F
        \u0441 \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u0439 \u0440\u0435\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0435\u0439.
        \u041E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435 \u043E\u0431\u043B\u0438\u043A\u0430
        \u0437\u0434\u0430\u043D\u0438\u044F \u0432\u044B\u0437\u0432\u0430\u043B\u043E
        \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E \u0441\u043F\u043E\u0440\u043E\u0432,
        \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u043B\u0438
        \u0432 \u043C\u0438\u0442\u0438\u043D\u0433\u0438 \u043A\u0430\u043A \u0437\u0430,
        \u0442\u0430\u043A \u0438 \u043F\u0440\u043E\u0442\u0438\u0432 \u0440\u0435\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438"
      objectReference: {fileID: 0}
