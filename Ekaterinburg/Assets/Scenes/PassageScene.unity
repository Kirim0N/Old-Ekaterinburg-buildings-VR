    - target: {fileID: 1107792321654673474, guid: aa7410302b2fb064792550c342148338, type: 3}
      propertyPath: m_text
      value: "\u0412 \u043D\u043E\u044F\u0431\u0440\u0435 2015 \u0440\u0435\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F
        \u043F\u043E\u0434\u043E\u0448\u043B\u0430 \u043A \u043A\u043E\u043D\u0446\u0443
        \u0438 \u0433\u043E\u0440\u043E\u0434 \u0443\u0432\u0438\u0434\u0435\u043B
        \u043D\u0435\u043A\u043E\u0433\u0434\u0430 \u0441\u0442\u0430\u0440\u043E\u0435,
        \u043D\u0435\u043F\u0440\u0438\u043C\u0435\u0442\u043D\u043E\u0435 \u0437\u0434\u0430\u043D\u0438\u0435
        \u0432 \u043D\u043E\u0432\u043E\u043C, \u044F\u0440\u043A\u043E\u043C \u043E\u0431\u043B\u0438\u043A\u0435.
        \u041F\u043E \u0438\u0442\u043E\u0433\u0443 \u043D\u0430 \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0439\u043A\u0443
        \u0431\u044B\u043B\u043E \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u043E
        3 \u0433\u043E\u0434\u0430 \u0438 200 \u043C\u043B\u043D. \u0434\u043E\u043B\u043B\u0430\u0440\u043E\u0432."
